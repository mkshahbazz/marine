# gateway/.env — copy to .env and fill in
PORT=4000
NODE_ENV=development

# MongoDB Atlas (free tier): https://cloud.mongodb.com -> New Project -> Build a Database -> Free
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/akatsuki

# Any random long string — used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# The existing Python/FastAPI service (backend/) — local or Render URL
AGENTIC_PLATFORM_URL=http://localhost:8000

# Bhashini: https://bhashini.gov.in -> Sign Up -> verify email -> Profile -> Generate API Key
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Your deployed frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
